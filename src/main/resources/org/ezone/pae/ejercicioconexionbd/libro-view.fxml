<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ezone.pae.ejercicioconexionbd.controller.LibroController">
    <children>
        <Label layoutX="222.0" layoutY="20.0" text="Inserción de libros">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Label layoutX="45.0" layoutY="60.0" text="Título" />
        <TextField fx:id="txtTitulo" layoutX="45.0" layoutY="77.0" prefWidth="230.0" promptText="Título del libro" />
        <Label layoutX="325.0" layoutY="60.0" text="Autor" />
        <TextField fx:id="txtAutor" layoutX="325.0" layoutY="77.0" prefWidth="230.0" promptText="Autor del libro" />
        <Label layoutX="45.0" layoutY="115.0" text="Categoría" />
        <ComboBox fx:id="cmbCategoria" layoutX="45.0" layoutY="132.0" prefWidth="230.0" />
        <Label layoutX="325.0" layoutY="115.0" text="Precio" />
        <TextField fx:id="txtPrecio" layoutX="325.0" layoutY="132.0" prefWidth="105.0" promptText="9.99" />
        <Label layoutX="450.0" layoutY="115.0" text="Stock" />
        <TextField fx:id="txtStock" layoutX="450.0" layoutY="132.0" prefWidth="105.0" promptText="50" />
        <Button fx:id="btnGuardar" layoutX="169.0" layoutY="175.0" mnemonicParsing="false" onAction="#guardarLibro" prefWidth="80.0" style="-fx-background-color: #BFE3E0; -fx-background-radius: 4;" text="Guardar" />
        <Button fx:id="btnLimpiar" layoutX="260.0" layoutY="175.0" mnemonicParsing="false" onAction="#limpiarCampos" prefWidth="80.0" style="-fx-background-color: #DDE3E8; -fx-background-radius: 4;" text="Limpiar" />
        <Button fx:id="btnActualizar" layoutX="348.0" layoutY="175.0" mnemonicParsing="false" onAction="#cargarLibros" prefHeight="25.0" prefWidth="105.0" style="-fx-background-color: #B9D7F0; -fx-background-radius: 4;" text="Actualizar tabla" />
        <TableView fx:id="tblLibros" layoutX="20.0" layoutY="220.0" prefHeight="160.0" prefWidth="560.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                <TableColumn fx:id="colTitulo" prefWidth="130.0" text="Título" />
                <TableColumn fx:id="colAutor" prefWidth="110.0" text="Autor" />
                <TableColumn fx:id="colCategoria" prefWidth="100.0" text="Categoría" />
                <TableColumn fx:id="colPrecio" prefWidth="90.0" text="Precio" />
                <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
